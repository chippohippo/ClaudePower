{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unbroken-ages.dev/schemas/mod.schema.json",
  "title": "Unbroken Ages mod manifest (mod.json)",
  "type": "object",
  "required": [
    "id",
    "name",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+){0,3}$"
    },
    "description": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "minVersion": {
            "type": "string"
          }
        }
      }
    },
    "loadAfter": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affectsGameplay": {
      "type": "boolean"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "localization": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ui": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}