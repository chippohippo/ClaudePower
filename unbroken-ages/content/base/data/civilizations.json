{
  // Major nations. Each has a SIGNATURE: a rule of the game it plays differently (NationSystem.cs), with tunable params.
  // Each leader's AUGMENT overrides or adds signature params, so the same nation plays differently under each leader.
  // Design notes: docs/05-key-systems/14-nations.md
  "$schema": "../../schemas/content.schema.json",
  "civilizations": [
    { "id": "CIV_EGYPT", "name": "Egypt", "adjective": "Egyptian", "startBias": ["TERRAIN_CHANNEL", "FEATURE_FLOODPLAINS"],
      "ability": { "name": "Gift of the Great River", "description": "+15% Production toward districts in cities on a Great River. Cities are never harmed by river floods.",
        "modifiers": [ { "effect": "CityProductionPercent", "category": "District", "amount": 15, "requirements": [ { "type": "CityOnGreatRiver" } ] },
                       { "effect": "CityDisasterImmunity", "disaster": "RiverFlood", "amount": 1 } ] },
      "signature": { "kind": "Inundation", "name": "The Royal Granary",
        "description": "Egyptian cities do not grow from their own food. Every surplus is shipped to the Royal Granary, which earns 20% interest. Every 8 turns the river floods: the granary pours into the cities (more to those on rivers and floodplains), and 40% of it also becomes production on whatever they are building.",
        "playstyle": "Growth comes in great pulses, not trickles. Plan around the flood: queue wonders and districts to land on flood turns, settle every river bank, and never let a city starve between floods.",
        "params": { "interval": 8, "interestPercent": 20, "productionPercent": 40, "freeUnit": 0, "goldPercent": 0 } },
      "cityNames": ["Waset", "Men-nefer", "Abydos", "Iunu", "Swenett", "Khmun", "Zau", "Djedu", "Behdet", "Nekhen"],
      "colors": { "primary": "#E3C16F", "secondary": "#1F4E79" } },

    { "id": "CIV_VENICE", "name": "Venice", "adjective": "Venetian", "startBias": ["TERRAIN_COAST", "TERRAIN_LAKE"],
      "ability": { "name": "Queen of the Lagoon", "description": "+2 Gold in coastal cities; +25% naval unit production with a Harbor.",
        "modifiers": [ { "effect": "CityYieldFlat", "yield": "Gold", "amount": 2, "requirements": [ { "type": "CityIsCoastal" } ] },
                       { "effect": "CityProductionPercent", "category": "Unit", "amount": 25, "requirements": [ { "type": "CityHasDistrict", "id": "DISTRICT_HARBOR" } ] } ] },
      "signature": { "kind": "Ledger", "name": "The Ledger Republic",
        "description": "Venice never trains Settlers. Instead it buys cities: any Free City, or any foreign city with loyalty below 60, within 8 tiles of a Venetian city, for gold (cheaper for small cities). Every Venetian city earns +1 Gold for each foreign city within 8 tiles.",
        "playstyle": "A merchant empire that grows by purchase, not by colonists. Hoard gold, court unhappy neighbours, and buy the cities others cannot hold.",
        "params": { "loyaltyThreshold": 60, "range": 8, "costBase": 120, "costPerPop": 70, "discountPercent": 0, "coastalDiscount": 0,
                    "warPurchase": 0, "warLoyaltyThreshold": 60, "boughtLoyalty": 75, "boughtPop": 0, "goldPerNeighbor": 1 } },
      "cityNames": ["Venezia", "Torcello", "Murano", "Chioggia", "Padova", "Treviso", "Zara", "Candia", "Corfu", "Negroponte"],
      "colors": { "primary": "#9B1B30", "secondary": "#F2C14E" } },

    { "id": "CIV_SONG", "name": "Song China", "adjective": "Song", "startBias": ["TERRAIN_CHANNEL", "RELIEF_HILLS"],
      "ability": { "name": "Imperial Examinations", "description": "+1 Science in cities of population 3 or more.",
        "modifiers": [ { "effect": "CityYieldFlat", "yield": "Science", "amount": 1, "requirements": [ { "type": "CityMinPopulation", "value": 3 } ] } ] },
      "signature": { "kind": "Mandate", "name": "The Mandate of Heaven",
        "description": "A Mandate meter rises by 3 each turn for every city with loyalty 75 or more, falls by 6 for every city below 50 and by 4 while at war. At 100 a Golden Dynasty begins: +25% Science, Production and Culture in every city for 10 turns. Losing a city during a dynasty ends it, and every city loses 20 loyalty.",
        "playstyle": "Order is power. Keep every city loyal and the borders quiet, and the empire surges in golden dynasties; a careless war or a lost city throws the whole realm into turmoil.",
        "params": { "gainPerLoyalCity": 3, "loyalThreshold": 75, "lossPerUnrestCity": 6, "warDrain": 4, "dynastyTurns": 10,
                    "dynastyPercent": 25, "culturePercent": 25, "collapseLoyalty": 20 } },
      "cityNames": ["Kaifeng", "Lin'an", "Luoyang", "Yangzhou", "Suzhou", "Quanzhou", "Chengdu", "Guangzhou", "Mingzhou", "Jiangling"],
      "colors": { "primary": "#2E7D5B", "secondary": "#F5E6C8" } },

    { "id": "CIV_MONGOLIA", "name": "Mongolia", "adjective": "Mongol", "startBias": ["TERRAIN_PLAINS", "TERRAIN_GRASSLAND"],
      "ability": { "name": "Riders of the Ordu", "description": "+15% Production toward units.",
        "modifiers": [ { "effect": "CityProductionPercent", "category": "Unit", "amount": 15 } ] },
      "signature": { "kind": "Horde", "name": "The Endless Steppe",
        "description": "Mongol cities make 40% less Science and 25% less Culture. Every enemy unit a Mongol unit destroys yields Science equal to twice its strength and Culture equal to its strength; every captured city yields 40 Science per citizen and one technology its owner knew. Mounted units have +1 movement and heal 15 HP after a kill.",
        "playstyle": "You learn by conquering. Peace starves your research, so ride out early, pick fights you can win and turn every battlefield into a library.",
        "params": { "sciencePenalty": 40, "culturePenalty": 25, "sciencePerStrength": 200, "culturePerStrength": 100, "citySciencePerPop": 40,
                    "stealTech": 1, "mountedMoves": 1, "healOnKill": 15, "goldPerStrength": 0, "terrorLoyalty": 0, "keepPopulation": 0, "capturedLoyalty": 50 } },
      "cityNames": ["Karakorum", "Avarga", "Khanbaliq", "Shangdu", "Kharkhorin", "Otrar", "Almaliq", "Sarai", "Tabriz", "Bukhara"],
      "colors": { "primary": "#3A6EA5", "secondary": "#E8D9B0" } },

    { "id": "CIV_INCA", "name": "Inca", "adjective": "Inca", "startBias": ["RELIEF_MOUNTAIN", "RELIEF_HILLS"],
      "ability": { "name": "The Four Quarters", "description": "+1 Production in cities with a hill or mountain next to the centre.",
        "modifiers": [] },
      "signature": { "kind": "SkyRoads", "name": "Roads in the Sky",
        "description": "Inca units cross mountains (2 movement). Inca citizens farm mountains in terraces (+2 Food, +1 Production) and hills (+1 Food).",
        "playstyle": "Where others see walls, you see farmland. Settle the high valleys, feed great cities from the peaks and strike from passes no one else can use.",
        "params": { "mountainMoveCost": 2, "mountainFood": 2, "mountainProduction": 1, "hillFood": 1, "mountainScience": 0, "highlandHousing": 0, "highlandCentreProduction": 1 } },
      "cityNames": ["Qusqu", "Machu Pikchu", "Quitu", "Vilcabamba", "Huánuco Pampa", "Tumipampa", "Cajamarca", "Ollantaytambo", "Pisaq", "Tampu"],
      "colors": { "primary": "#C2512B", "secondary": "#F7E3A1" } },

    { "id": "CIV_MALI", "name": "Mali", "adjective": "Malian", "startBias": ["TERRAIN_DESERT", "TERRAIN_PLAINS"],
      "ability": { "name": "Salt and Gold", "description": "+1 Gold in every city.",
        "modifiers": [ { "effect": "CityYieldFlat", "yield": "Gold", "amount": 1 } ] },
      "signature": { "kind": "GoldenRoad", "name": "The Golden Road",
        "description": "Malian cities make 30% less Production, but desert tiles yield +1 Gold and mines +2 Gold, purchases cost 35% less, and the treasury earns 2% interest each turn (up to 25 Gold).",
        "playstyle": "You do not build, you buy. Work the desert and the mines, keep a fat treasury, and purchase your armies, buildings and districts outright.",
        "params": { "productionPenalty": 30, "desertGold": 1, "mineGold": 2, "purchaseDiscount": 35, "interestPercent": 2, "interestCap": 25,
                    "purchaseSciencePercent": 0, "purchaseFaithPercent": 0, "unitDiscount": 0 } },
      "cityNames": ["Niani", "Timbuktu", "Djenné", "Gao", "Walata", "Kangaba", "Takedda", "Koumbi Saleh", "Mema", "Tadmekka"],
      "colors": { "primary": "#D9A21B", "secondary": "#5B2C11" } }
  ],

  "leaders": [
    { "id": "LEADER_THUTMOSE", "name": "Thutmose III", "epithet": "The Warrior Pharaoh", "civilization": "CIV_EGYPT",
      "ability": { "name": "Megiddo Campaign", "description": "+10% Production toward units.",
        "modifiers": [ { "effect": "CityProductionPercent", "category": "Unit", "amount": 10 } ] },
      "augment": { "name": "Levies of the Flood", "description": "Every Inundation also musters your best melee unit in the capital.", "params": { "freeUnit": 1 } },
      "agenda": { "name": "Restorer of Order", "description": "Respects civilizations whose cities are loyal; scorns those whose cities rebel.",
        "likes": ["HighLoyalty"], "dislikes": ["CitiesInRevolt"] },
      "personality": { "war": 1.3, "expansion": 1.1, "science": 1.0 } },
    { "id": "LEADER_HATSHEPSUT", "name": "Hatshepsut", "epithet": "Foremost of Noble Women", "civilization": "CIV_EGYPT",
      "ability": { "name": "Expedition to Punt", "description": "+1 Gold in cities on a Great River.",
        "modifiers": [ { "effect": "CityYieldFlat", "yield": "Gold", "amount": 1, "requirements": [ { "type": "CityOnGreatRiver" } ] } ] },
      "augment": { "name": "Seasons of Plenty", "description": "The river floods every 6 turns instead of 8, and each flood also pays half the granary's worth in Gold.", "params": { "interval": 6, "goldPercent": 50 } },
      "agenda": { "name": "Builder of Monuments", "description": "Admires wealthy civilizations; distrusts warmongers.",
        "likes": ["TradePartner"], "dislikes": ["Warmonger"] },
      "personality": { "war": 0.6, "gold": 1.3, "growth": 1.3 } },

    { "id": "LEADER_DANDOLO", "name": "Enrico Dandolo", "epithet": "The Blind Doge", "civilization": "CIV_VENICE",
      "ability": { "name": "The Blind Doge", "description": "Purchases cost 10% less gold.",
        "modifiers": [ { "effect": "CityPurchaseDiscountPercent", "amount": 10 } ] },
      "augment": { "name": "The Diversion of Zara", "description": "Can also buy the cities of civilizations at war with Venice when their loyalty is below 85; every city purchase costs 15% less.", "params": { "warPurchase": 1, "warLoyaltyThreshold": 85, "discountPercent": 15 } },
      "agenda": { "name": "Merchant Prince", "description": "Likes trading partners; dislikes anyone who blockades trade.",
        "likes": ["TradePartner"], "dislikes": ["Blockade"] },
      "personality": { "gold": 1.4, "war": 1.0, "naval": 1.5 } },
    { "id": "LEADER_ORSEOLO", "name": "Pietro II Orseolo", "epithet": "Lord of Dalmatia", "civilization": "CIV_VENICE",
      "ability": { "name": "Golden Bull", "description": "+1 Gold in every coastal city.",
        "modifiers": [ { "effect": "CityYieldFlat", "yield": "Gold", "amount": 1, "requirements": [ { "type": "CityIsCoastal" } ] } ] },
      "augment": { "name": "Protector of the Coast", "description": "Coastal cities cost 35% less to buy, and bought cities arrive fully loyal with +1 citizen.", "params": { "coastalDiscount": 35, "boughtLoyalty": 100, "boughtPop": 1 } },
      "agenda": { "name": "Keeper of the Sea Lanes", "description": "Likes trading partners; dislikes warmongers.",
        "likes": ["TradePartner"], "dislikes": ["Warmonger"] },
      "personality": { "gold": 1.5, "war": 0.6, "naval": 1.6 } },

    { "id": "LEADER_TAIZU_SONG", "name": "Emperor Taizu", "epithet": "Founder of the Song", "civilization": "CIV_SONG",
      "ability": { "name": "A Cup of Wine", "description": "+2 Loyalty per turn in all cities.",
        "modifiers": [ { "effect": "CityLoyaltyPerTurn", "amount": 2 } ] },
      "augment": { "name": "Generals Retired with Honour", "description": "Golden Dynasties last 14 turns.", "params": { "dynastyTurns": 14 } },
      "agenda": { "name": "Civil Over Martial", "description": "Likes peaceful scholars; dislikes warmongers.",
        "likes": ["HighScience", "Peaceful"], "dislikes": ["Warmonger"] },
      "personality": { "science": 1.3, "war": 0.7 } },
    { "id": "LEADER_HUIZONG", "name": "Emperor Huizong", "epithet": "Emperor of Brush and Silk", "civilization": "CIV_SONG",
      "ability": { "name": "The Painting Academy", "description": "+2 Culture in the capital.",
        "modifiers": [ { "effect": "CityYieldFlat", "yield": "Culture", "amount": 2, "requirements": [ { "type": "CityIsCapital" } ] } ] },
      "augment": { "name": "Slender Gold", "description": "The Mandate rises 4 per loyal city and dynasties give +60% Culture, but war drains the Mandate twice as fast.", "params": { "gainPerLoyalCity": 4, "culturePercent": 60, "warDrain": 8 } },
      "agenda": { "name": "Patron of the Arts", "description": "Admires cultured, peaceful realms; scorns warmongers.",
        "likes": ["Peaceful"], "dislikes": ["Warmonger"] },
      "personality": { "science": 1.1, "war": 0.4, "growth": 1.2 } },

    { "id": "LEADER_GENGHIS", "name": "Genghis Khan", "epithet": "Khan of the Steppe", "civilization": "CIV_MONGOLIA",
      "ability": { "name": "The Yassa", "description": "+2 Loyalty per turn in all cities.",
        "modifiers": [ { "effect": "CityLoyaltyPerTurn", "amount": 2 } ] },
      "augment": { "name": "Terror of the Steppe", "description": "Kills also pay Gold equal to the victim's strength, and enemy cities with a Mongol unit next to them lose 5 loyalty a turn.", "params": { "goldPerStrength": 100, "terrorLoyalty": 5 } },
      "agenda": { "name": "Ruler of Many Peoples", "description": "Respects strong armies; scorns the weak.",
        "likes": ["HighLoyalty"], "dislikes": ["Peaceful"] },
      "personality": { "war": 1.8, "expansion": 1.2, "science": 0.7 } },
    { "id": "LEADER_KUBLAI", "name": "Kublai Khan", "epithet": "Emperor of the Yuan", "civilization": "CIV_MONGOLIA",
      "ability": { "name": "Paper Money", "description": "+1 Gold in every city.",
        "modifiers": [ { "effect": "CityYieldFlat", "yield": "Gold", "amount": 1 } ] },
      "augment": { "name": "The Yuan Synthesis", "description": "The Science penalty is only 20%, and captured cities keep their citizens and start at 80 loyalty.", "params": { "sciencePenalty": 20, "keepPopulation": 1, "capturedLoyalty": 80 } },
      "agenda": { "name": "Great Khan of Khans", "description": "Likes scholars and trading partners; dislikes those who resist him.",
        "likes": ["HighScience", "TradePartner"], "dislikes": ["Warmonger"] },
      "personality": { "war": 1.3, "science": 1.1, "gold": 1.2 } },

    { "id": "LEADER_PACHACUTI", "name": "Pachacuti", "epithet": "Earth-Shaker", "civilization": "CIV_INCA",
      "ability": { "name": "Rebuilder of Qusqu", "description": "+15% Production toward districts.",
        "modifiers": [ { "effect": "CityProductionPercent", "category": "District", "amount": 15 } ] },
      "augment": { "name": "Qhapaq Ñan", "description": "Mountains cost only 1 movement, and terraced mountains give +2 Production.", "params": { "mountainMoveCost": 1, "mountainProduction": 2 } },
      "agenda": { "name": "Lord of the Four Quarters", "description": "Respects loyal realms; scorns those in revolt.",
        "likes": ["HighLoyalty"], "dislikes": ["CitiesInRevolt"] },
      "personality": { "war": 1.2, "expansion": 1.3 } },
    { "id": "LEADER_TOPA_INCA", "name": "Topa Inca Yupanqui", "epithet": "The Resettler", "civilization": "CIV_INCA",
      "ability": { "name": "Mitma", "description": "+2 Loyalty per turn in all cities.",
        "modifiers": [ { "effect": "CityLoyaltyPerTurn", "amount": 2 } ] },
      "augment": { "name": "Vertical Archipelago", "description": "Cities with two or more mountains in reach gain +2 Housing and +1 Amenity; terraced mountains also give +1 Science.", "params": { "highlandHousing": 2, "mountainScience": 1 } },
      "agenda": { "name": "Keeper of the Storehouses", "description": "Likes well-fed, peaceful neighbours.",
        "likes": ["Peaceful"], "dislikes": ["Warmonger"] },
      "personality": { "growth": 1.4, "war": 0.8, "expansion": 1.2 } },

    { "id": "LEADER_MANSA_MUSA", "name": "Mansa Musa", "epithet": "Lord of the Mines of Wangara", "civilization": "CIV_MALI",
      "ability": { "name": "The Pilgrimage", "description": "+2 Faith in the capital.",
        "modifiers": [ { "effect": "CityYieldFlat", "yield": "Faith", "amount": 2, "requirements": [ { "type": "CityIsCapital" } ] } ] },
      "augment": { "name": "Gold Upon the Road", "description": "Interest is 3% (up to 40 Gold), and every purchase also grants Science and Faith worth 10% of its price.", "params": { "interestPercent": 3, "interestCap": 40, "purchaseSciencePercent": 10, "purchaseFaithPercent": 10 } },
      "agenda": { "name": "Generous Pilgrim", "description": "Likes trading partners; dislikes the poor and warlike.",
        "likes": ["TradePartner"], "dislikes": ["Warmonger"] },
      "personality": { "gold": 1.7, "war": 0.6, "science": 1.1 } },
    { "id": "LEADER_SUNDIATA", "name": "Sundiata Keita", "epithet": "The Lion of Manden", "civilization": "CIV_MALI",
      "ability": { "name": "Kouroukan Fouga", "description": "+1 Loyalty per turn in all cities.",
        "modifiers": [ { "effect": "CityLoyaltyPerTurn", "amount": 1 } ] },
      "augment": { "name": "The Lion's Host", "description": "The Production penalty is only 15%, and units cost 20% less to buy.", "params": { "productionPenalty": 15, "unitDiscount": 20 } },
      "agenda": { "name": "Founder of Manden", "description": "Respects strength; distrusts the faithless.",
        "likes": ["HighLoyalty"], "dislikes": ["Peaceful"] },
