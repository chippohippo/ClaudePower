      "cityNames": ["Waset", "Men-nefer", "Abydos", "Iunu", "Swenett", "Khmun", "Zau", "Djedu", "Behdet", "Nekhen"],
      "colors": { "primary": "#E3C16F", "secondary": "#1F4E79" } },

