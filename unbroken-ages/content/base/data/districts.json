{
  // Districts are the heart of city planning. Adjacency rules are pure data: the same rules drive
  // yields, the placement lens, map-tack previews and the AI planner.
  "$schema": "../../schemas/content.schema.json",
  "districts": [
    { "id": "DISTRICT_CITY_CENTER", "name": "City Center", "category": "CityCenter", "cost": 0, "countsTowardLimit": false,
      "tags": ["CityCenter"],
      "description": "The capital's City Center also hosts the Palace.",
      "modifiers": [
        { "effect": "CityYieldFlat", "yield": "Science", "amount": 2, "requirements": [ { "type": "CityIsCapital" } ] },
        { "effect": "CityYieldFlat", "yield": "Culture", "amount": 1, "requirements": [ { "type": "CityIsCapital" } ] },
        { "effect": "CityYieldFlat", "yield": "Gold", "amount": 3, "requirements": [ { "type": "CityIsCapital" } ] },
        { "effect": "CityYieldFlat", "yield": "Production", "amount": 2, "requirements": [ { "type": "CityIsCapital" } ] },
        { "effect": "CityAmenities", "amount": 1, "requirements": [ { "type": "CityIsCapital" } ] }
      ] },

    { "id": "DISTRICT_ACADEMY", "name": "Academy", "category": "Specialty", "primaryYield": "Science", "cost": 54,
      "prereqTech": "TECH_WRITING", "tags": ["Specialty", "Science"],
      "description": "Seat of learning. Loves mountains, geothermal vents, reefs and dense rainforest.",
      "adjacency": [
        { "yield": "Science", "amount": 1, "source": { "relief": "RELIEF_MOUNTAIN" } },
        { "yield": "Science", "amount": 2, "source": { "feature": "FEATURE_GEOTHERMAL" } },
        { "yield": "Science", "amount": 1, "source": { "feature": "FEATURE_REEF" } },
        { "yield": "Science", "amount": 1, "per": 2, "source": { "feature": "FEATURE_RAINFOREST" } },
        { "yield": "Science", "amount": 1, "per": 2, "source": { "anyDistrict": true } }
      ] },

    { "id": "DISTRICT_SANCTUARY", "name": "Sanctuary", "category": "Specialty", "primaryYield": "Faith", "cost": 54,
      "prereqTech": "TECH_ASTROLOGY", "tags": ["Specialty", "Faith"],
      "adjacency": [
        { "yield": "Faith", "amount": 1, "source": { "relief": "RELIEF_MOUNTAIN" } },
        { "yield": "Faith", "amount": 1, "source": { "terrainClass": "Channel" }, "label": "+1 Faith per adjacent Great River (sacred waters)" },
        { "yield": "Faith", "amount": 1, "per": 2, "source": { "featureTag": "Woods" } },
        { "yield": "Faith", "amount": 1, "per": 2, "source": { "anyDistrict": true } }
      ] },

    { "id": "DISTRICT_MARKET", "name": "Market Quarter", "category": "Specialty", "primaryYield": "Gold", "cost": 54,
      "prereqTech": "TECH_CURRENCY", "tags": ["Specialty", "Gold"],
      "adjacency": [
        { "yield": "Gold", "amount": 2, "scope": "Self", "source": { "riverEdge": true }, "label": "+2 Gold: a river runs along this district" },
        { "yield": "Gold", "amount": 2, "source": { "districtTag": "Port" }, "label": "+2 Gold per adjacent Harbor or River Port" },
        { "yield": "Gold", "amount": 1, "source": { "terrainClass": "Channel" }, "label": "+1 Gold per adjacent Great River" },
        { "yield": "Gold", "amount": 1, "per": 2, "source": { "anyDistrict": true } }
      ] },

    { "id": "DISTRICT_HARBOR", "name": "Harbor", "category": "Specialty", "primaryYield": "Gold", "cost": 54,
      "prereqTech": "TECH_CELESTIAL_NAVIGATION", "tags": ["Specialty", "Gold", "Port"],
      "placement": { "onWater": true, "allowedTerrainClasses": ["Coast", "Lake"], "requiresAdjacentAny": [ { "terrainClass": "Land" } ] },
      "adjacency": [
        { "yield": "Gold", "amount": 2, "source": { "cityCenter": true } },
        { "yield": "Gold", "amount": 1, "source": { "terrainClass": "Coast", "hasResource": true }, "label": "+1 Gold per adjacent sea resource" },
        { "yield": "Gold", "amount": 1, "per": 2, "source": { "anyDistrict": true } }
      ] },

    { "id": "DISTRICT_RIVER_PORT", "name": "River Port", "category": "Specialty", "primaryYield": "Gold", "cost": 54,
      "prereqTech": "TECH_SAILING", "tags": ["Specialty", "Gold", "Port"],
      "description": "Built on a Great River. Trains river boats, hosts river trade routes, and links Markets and Foundries.",
      "placement": { "onWater": true, "allowedTerrainClasses": ["Channel"] },
      "adjacency": [
        { "yield": "Gold", "amount": 2, "source": { "district": "DISTRICT_MARKET" } },
        { "yield": "Gold", "amount": 1, "per": 2, "source": { "terrainClass": "Channel" }, "label": "+1 Gold per 2 adjacent Great River tiles" },
        { "yield": "Production", "amount": 1, "source": { "district": "DISTRICT_FOUNDRY" } },
        { "yield": "Gold", "amount": 1, "per": 2, "source": { "anyDistrict": true } }
      ] },

    { "id": "DISTRICT_CULTURAL_QUARTER", "name": "Cultural Quarter", "category": "Specialty", "primaryYield": "Culture", "cost": 54,
      "prereqCivic": "CIVIC_RECORDED_HISTORY", "tags": ["Specialty", "Culture"],
      "adjacency": [
        { "yield": "Culture", "amount": 2, "source": { "districtTag": "Wonder" }, "label": "+2 Culture per adjacent Wonder" },
        { "yield": "Culture", "amount": 1, "source": { "district": "DISTRICT_ARENA" } },
        { "yield": "Culture", "amount": 1, "per": 2, "source": { "freshWater": true }, "label": "+1 Culture per 2 adjacent lakes, oases or Great River tiles" },
        { "yield": "Culture", "amount": 1, "per": 2, "source": { "anyDistrict": true } }
      ] },

    { "id": "DISTRICT_FOUNDRY", "name": "Foundry", "category": "Specialty", "primaryYield": "Production", "cost": 54,
      "prereqTech": "TECH_APPRENTICESHIP", "tags": ["Specialty", "Production"],
      "adjacency": [
        { "yield": "Production", "amount": 1, "source": { "improvement": "IMPROVEMENT_MINE" } },
        { "yield": "Production", "amount": 2, "source": { "districtTag": "Waterworks" }, "label": "+2 Production per adjacent Aqueduct, Dam or Canal" },
        { "yield": "Production", "amount": 1, "source": { "district": "DISTRICT_RIVER_PORT" } },
        { "yield": "Production", "amount": 1, "per": 2, "source": { "anyDistrict": true } }
      ] },

    { "id": "DISTRICT_GARRISON", "name": "Garrison", "category": "Specialty", "cost": 54, "prereqTech": "TECH_BRONZE_WORKING",
      "tags": ["Specialty", "Military"], "placement": { "forbidAdjacentCityCenter": true } },

    { "id": "DISTRICT_ARENA", "name": "Arena Quarter", "category": "Specialty", "cost": 54, "prereqCivic": "CIVIC_PUBLIC_GAMES",
      "amenities": 1, "appeal": 1, "tags": ["Specialty", "Entertainment"] },

    { "id": "DISTRICT_CIVIC_PLAZA", "name": "Civic Plaza", "category": "Specialty", "cost": 30, "uniquePerCiv": true,
      "prereqCivic": "CIVIC_POLITICAL_PHILOSOPHY", "tags": ["Specialty", "Government"],
      "description": "One per empire. Grants +1 adjacency to every adjacent specialty district and steadies loyalty.",
      "providesAdjacency": [ { "toTag": "Specialty", "amount": 1, "label": "+1 from adjacent Civic Plaza" } ],
      "modifiers": [ { "effect": "CityLoyaltyPerTurn", "amount": 4 } ] },

    { "id": "DISTRICT_AQUEDUCT", "name": "Aqueduct", "category": "Infrastructure", "cost": 36, "countsTowardLimit": false,
      "prereqTech": "TECH_ENGINEERING", "housing": 6, "tags": ["Infrastructure", "Waterworks"],
      "placement": {
        "requiresAdjacentCityCenter": true,
        "requiresAdjacentAny": [
          { "relief": "RELIEF_MOUNTAIN" }, { "terrainClass": "Lake" }, { "terrainClass": "Channel" },
          { "feature": "FEATURE_OASIS" }, { "riverEdge": true }
        ] } },

    { "id": "DISTRICT_DAM", "name": "Dam", "category": "Infrastructure", "cost": 81, "countsTowardLimit": false,
      "prereqTech": "TECH_ENGINEERING", "tags": ["Infrastructure", "Waterworks"],
      "description": "Tames a river: the city ignores river floods. Enables Hydroelectric power.",
      "placement": { "requiresFeature": "FEATURE_FLOODPLAINS", "minRiverEdges": 2 },
      "modifiers": [ { "effect": "CityDisasterImmunity", "disaster": "RiverFlood", "amount": 1 }, { "effect": "CityAmenities", "amount": 1 } ] },

    { "id": "DISTRICT_CANAL", "name": "Canal", "category": "Infrastructure", "cost": 81, "countsTowardLimit": false, "maxPerCity": 3,
      "prereqTech": "TECH_ENGINEERING", "tags": ["Infrastructure", "Waterworks"],
      "placement": { "special": "Canal", "allowedReliefs": ["RELIEF_FLAT"] } },

    { "id": "DISTRICT_NEIGHBORHOOD", "name": "Neighborhood", "category": "Infrastructure", "cost": 54, "countsTowardLimit": false, "maxPerCity": 10,
      "prereqCivic": "CIVIC_URBANIZATION", "tags": ["Infrastructure", "Residential"],
      "description": "Housing scales with Appeal (3–6)." },

    { "id": "DISTRICT_AIRFIELD", "name": "Airfield", "category": "Specialty", "cost": 54, "prereqTech": "TECH_FLIGHT",
      "tags": ["Specialty", "Military"], "placement": { "allowedReliefs": ["RELIEF_FLAT"] } },

    { "id": "DISTRICT_SPACEPORT", "name": "Spaceport", "category": "Infrastructure", "cost": 900, "countsTowardLimit": false,
      "prereqTech": "TECH_ROCKETRY", "tags": ["Infrastructure"], "placement": { "allowedReliefs": ["RELIEF_FLAT"] } },

    { "id": "DISTRICT_ARSENAL", "name": "Arsenal", "category": "Specialty", "primaryYield": "Production", "cost": 27,
      "prereqTech": "TECH_APPRENTICESHIP", "civilization": "CIV_VENICE", "replaces": "DISTRICT_FOUNDRY", "tags": ["Specialty", "Production"],
      "description": "Venetian Foundry. Half cost; must touch water; thrives next to ports.",
      "placement": { "requiresAdjacentAny": [ { "terrainClass": "Coast" }, { "terrainClass": "Lake" }, { "terrainClass": "Channel" } ] },
      "adjacency": [
        { "yield": "Production", "amount": 2, "source": { "districtTag": "Port" } },
        { "yield": "Production", "amount": 2, "source": { "districtTag": "Waterworks" } },
        { "yield": "Production", "amount": 1, "source": { "improvement": "IMPROVEMENT_MINE" } },
        { "yield": "Production", "amount": 1, "per": 2, "source": { "anyDistrict": true } }
      ],
      "modifiers": [ { "effect": "CityProductionPercent", "category": "Unit", "amount": 25 } ] },

    { "id": "DISTRICT_HANLIN_ACADEMY", "name": "Hanlin Academy", "category": "Specialty", "primaryYield": "Science", "cost": 27,
      "prereqTech": "TECH_WRITING", "civilization": "CIV_SONG", "replaces": "DISTRICT_ACADEMY", "tags": ["Specialty", "Science"],
      "adjacency": [
        { "yield": "Science", "amount": 1, "source": { "relief": "RELIEF_MOUNTAIN" } },
        { "yield": "Science", "amount": 2, "source": { "district": "DISTRICT_CULTURAL_QUARTER" } },
        { "yield": "Culture", "amount": 1, "per": 2, "source": { "anyDistrict": true } },
        { "yield": "Science", "amount": 1, "per": 2, "source": { "anyDistrict": true } }
      ] },

    // ----- World wonders (one in the world; docs/05-key-systems/15-society.md) -----
    {"id": "WONDER_GREAT_PYRAMIDS", "name": "Great Pyramids", "category": "Wonder", "cost": 120, "countsTowardLimit": false, "uniquePerCiv": true, "prereqTech": "TECH_MASONRY", "tags": ["Wonder"], "description": "+2 Production, +2 Culture. Builders trained anywhere in the empire get +1 charge.", "placement": {"allowedReliefs": ["RELIEF_FLAT"]}, "modifiers": [{"effect": "CityYieldFlat", "yield": "Production", "amount": 2}, {"effect": "CityYieldFlat", "yield": "Culture", "amount": 2}], "empireModifiers": [{"effect": "BuilderCharges", "amount": 1}], "model": "wonders/giza"},
    {"id": "WONDER_HANGING_GARDENS", "name": "Hanging Gardens", "category": "Wonder", "cost": 120, "countsTowardLimit": false, "uniquePerCiv": true, "prereqTech": "TECH_IRRIGATION", "tags": ["Wonder"], "description": "Must stand on a river. +2 Housing here; +10% Food in every city.", "placement": {"minRiverEdges": 1}, "modifiers": [{"effect": "CityHousing", "amount": 2}], "empireModifiers": [{"effect": "CityYieldPercent", "yield": "Food", "amount": 10}], "model": "wonders/hanging_gardens"},
    {"id": "WONDER_ORACLE", "name": "Oracle", "category": "Wonder", "cost": 120, "countsTowardLimit": false, "uniquePerCiv": true, "prereqCivic": "CIVIC_MYSTICISM", "tags": ["Wonder"], "description": "Must stand on hills. +4 Faith, +2 Culture.", "placement": {"allowedReliefs": ["RELIEF_HILLS"]}, "modifiers": [{"effect": "CityYieldFlat", "yield": "Faith", "amount": 4}, {"effect": "CityYieldFlat", "yield": "Culture", "amount": 2}], "model": "wonders/oracle"},
    {"id": "WONDER_COLOSSUS", "name": "Colossus", "category": "Wonder", "cost": 130, "countsTowardLimit": false, "uniquePerCiv": true, "prereqTech": "TECH_SAILING", "tags": ["Wonder"], "description": "Built in the coastal waters. +4 Gold; +1 Gold in every coastal city.", "placement": {"onWater": true, "allowedTerrainClasses": ["Coast"], "requiresAdjacentAny": [{"terrainClass": "Land"}]}, "modifiers": [{"effect": "CityYieldFlat", "yield": "Gold", "amount": 4}], "empireModifiers": [{"effect": "CityYieldFlat", "yield": "Gold", "amount": 1, "requirements": [{"type": "CityIsCoastal"}]}], "model": "wonders/colossus"},
    {"id": "WONDER_GREAT_LIBRARY", "name": "Great Library", "category": "Wonder", "cost": 150, "countsTowardLimit": false, "uniquePerCiv": true, "prereqTech": "TECH_WRITING", "tags": ["Wonder"], "description": "+3 Science, +2 Culture; +1 Science in every city with an Academy.", "modifiers": [{"effect": "CityYieldFlat", "yield": "Science", "amount": 3}, {"effect": "CityYieldFlat", "yield": "Culture", "amount": 2}], "empireModifiers": [{"effect": "CityYieldFlat", "yield": "Science", "amount": 1, "requirements": [{"type": "CityHasDistrict", "id": "DISTRICT_ACADEMY"}]}], "model": "wonders/great_library"},
    {"id": "WONDER_TERRACOTTA_ARMY", "name": "Terracotta Army", "category": "Wonder", "cost": 160, "countsTowardLimit": false, "uniquePerCiv": true, "prereqTech": "TECH_BRONZE_WORKING", "tags": ["Wonder"], "description": "+2 Production; every military unit +3 strength.", "placement": {"allowedReliefs": ["RELIEF_FLAT"]}, "modifiers": [{"effect": "CityYieldFlat", "yield": "Production", "amount": 2}], "empireModifiers": [{"effect": "UnitStrength", "amount": 3}], "model": "wonders/terracotta"},
    {"id": "WONDER_MACHU_PICCHU", "name": "Machu Picchu", "category": "Wonder", "cost": 160, "countsTowardLimit": false, "uniquePerCiv": true, "prereqCivic": "CIVIC_STATE_WORKFORCE", "tags": ["Wonder"], "description": "Must touch a mountain. +3 Gold, +2 Production; +5% Production in every city.", "placement": {"requiresAdjacentAny": [{"relief": "RELIEF_MOUNTAIN"}]}, "modifiers": [{"effect": "CityYieldFlat", "yield": "Gold", "amount": 3}, {"effect": "CityYieldFlat", "yield": "Production", "amount": 2}], "empireModifiers": [{"effect": "CityYieldPercent", "yield": "Production", "amount": 5}], "model": "wonders/machu_picchu"},
    {"id": "WONDER_HAGIA_SOPHIA", "name": "Hagia Sophia", "category": "Wonder", "cost": 220, "countsTowardLimit": false, "uniquePerCiv": true, "prereqTech": "TECH_EDUCATION", "tags": ["Wonder"], "description": "+4 Faith; +1 Faith in every city.", "placement": {"allowedReliefs": ["RELIEF_FLAT"]}, "modifiers": [{"effect": "CityYieldFlat", "yield": "Faith", "amount": 4}], "empireModifiers": [{"effect": "CityYieldFlat", "yield": "Faith", "amount": 1}], "model": "wonders/hagia_sophia"},
    {"id": "WONDER_FORBIDDEN_CITY", "name": "Forbidden City", "category": "Wonder", "cost": 260, "countsTowardLimit": false, "uniquePerCiv": true, "prereqCivic": "CIVIC_CIVIL_ENGINEERING", "tags": ["Wonder"], "description": "+3 Culture; +2 Loyalty a turn in every city; +1 wildcard policy slot.", "placement": {"allowedReliefs": ["RELIEF_FLAT"]}, "modifiers": [{"effect": "CityYieldFlat", "yield": "Culture", "amount": 3}], "empireModifiers": [{"effect": "CityLoyaltyPerTurn", "amount": 2}], "wildcardSlots": 1, "model": "wonders/forbidden_city"},
    {"id": "WONDER_OXFORD_UNIVERSITY", "name": "Oxford University", "category": "Wonder", "cost": 240, "countsTowardLimit": false, "uniquePerCiv": true, "prereqTech": "TECH_EDUCATION", "tags": ["Wonder"], "description": "+3 Science and +20% Science here.", "modifiers": [{"effect": "CityYieldFlat", "yield": "Science", "amount": 3}, {"effect": "CityYieldPercent", "yield": "Science", "amount": 20}], "model": "wonders/oxford"},
    {"id": "WONDER_BIG_BEN", "name": "Big Ben", "category": "Wonder", "cost": 300, "countsTowardLimit": false, "uniquePerCiv": true, "prereqTech": "TECH_INDUSTRIALIZATION", "tags": ["Wonder"], "description": "Must stand on a river. +4 Gold; +10% Gold in every city.", "placement": {"minRiverEdges": 1}, "modifiers": [{"effect": "CityYieldFlat", "yield": "Gold", "amount": 4}], "empireModifiers": [{"effect": "CityYieldPercent", "yield": "Gold", "amount": 10}], "model": "wonders/big_ben"},
    {"id": "WONDER_EIFFEL_TOWER", "name": "Eiffel Tower", "category": "Wonder", "cost": 320, "countsTowardLimit": false, "uniquePerCiv": true, "prereqTech": "TECH_ELECTRICITY", "tags": ["Wonder"], "description": "+3 Culture; +1 Amenity in every city.", "placement": {"allowedReliefs": ["RELIEF_FLAT"]}, "modifiers": [{"effect": "CityYieldFlat", "yield": "Culture", "amount": 3}], "empireModifiers": [{"effect": "CityAmenities", "amount": 1}], "model": "wonders/eiffel"},
    {"id": "WONDER_OPERA_HOUSE", "name": "Harbour Opera House", "category": "Wonder", "cost": 340, "countsTowardLimit": false, "uniquePerCiv": true, "prereqCivic": "CIVIC_URBANIZATION", "tags": ["Wonder"], "description": "Must touch the coast. +6 Culture; +5% Culture in every city.", "placement": {"requiresAdjacentAny": [{"terrainClass": "Coast"}]}, "modifiers": [{"effect": "CityYieldFlat", "yield": "Culture", "amount": 6}], "empireModifiers": [{"effect": "CityYieldPercent", "yield": "Culture", "amount": 5}], "model": "wonders/opera_house"},
    {"id": "WONDER_COSMODROME", "name": "Cosmodrome", "category": "Wonder", "cost": 400, "countsTowardLimit": false, "uniquePerCiv": true, "prereqTech": "TECH_ROCKETRY", "tags": ["Wonder"], "description": "+4 Science; +10% Science in every city.", "placement": {"allowedReliefs": ["RELIEF_FLAT"]}, "modifiers": [{"effect": "CityYieldFlat", "yield": "Science", "amount": 4}], "empireModifiers": [{"effect": "CityYieldPercent", "yield": "Science", "amount": 10}], "model": "wonders/launch_complex"}
  ]
}
