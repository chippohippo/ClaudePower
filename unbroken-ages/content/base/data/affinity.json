{
  // AFFINITIES AND THE TREE TO AD 2400 (docs/08-divergence-tech-tree.md §Affinities).
  // The Divergence's three futures are affinities every people climbs: Harmony (DIVERGENCE_SYMBIONT), Purity (DIVERGENCE_SOVEREIGN)
  // and Supremacy (DIVERGENCE_DISCARNATE). Anything here may grant affinity points ("affinity": { id: points }) or need a level
  // ("requiresAffinity", "requiresAffinityLevel"). Four eras follow the Future: Near Future (AD 2050-2150), Orbital (2150-2250),
  // Deep Space (2250-2350) and Singularity (2350-2400+). Each closes on a capstone that only the people who chose that affinity can
  // research: it unlocks the last project of their victory (Transcendence, Emancipation, the Digital Singularity).
  "$schema": "../../schemas/content.schema.json",

  "techs": [
    // ----- Near Future (AD 2050-2150) -----
    { "id": "TECH_FUSION_POWER", "name": "Fusion Power", "era": "ERA_NEAR_FUTURE", "cost": 3500, "prereqs": ["TECH_THRESHOLD"],
      "quote": "The sun's trick, at last, in a bottle the size of a cathedral." },
    { "id": "TECH_SMART_MATERIALS", "name": "Smart Materials", "era": "ERA_NEAR_FUTURE", "cost": 3500, "prereqs": ["TECH_THRESHOLD"],
      "quote": "The bridge noticed the crack before the engineers did, and closed it." },
    { "id": "TECH_ORBITAL_INFRASTRUCTURE", "name": "Orbital Infrastructure", "era": "ERA_NEAR_FUTURE", "cost": 3600, "prereqs": ["TECH_THRESHOLD"],
      "quote": "Low orbit stopped being a frontier and became a suburb." },
    { "id": "TECH_XENOBIOLOGY", "name": "Xenobiology", "era": "ERA_NEAR_FUTURE", "cost": 3600, "prereqs": ["TECH_THRESHOLD"],
      "affinity": { "DIVERGENCE_SYMBIONT": 3 }, "boostAffinity": "DIVERGENCE_SYMBIONT", "boostLevel": 2,
      "boost": "Reach Harmony level 2.", "quote": "Life is stranger than we thought, and closer." },
    { "id": "TECH_GENE_DRIVES", "name": "Gene Drives", "era": "ERA_NEAR_FUTURE", "cost": 3700, "prereqs": ["TECH_XENOBIOLOGY"],
      "affinity": { "DIVERGENCE_SYMBIONT": 2, "DIVERGENCE_SOVEREIGN": 1 },
      "quote": "We rewrote the mosquito. Then the wheat. Then, very quietly, ourselves." },
    { "id": "TECH_ECO_ENGINEERING", "name": "Eco-Engineering", "era": "ERA_NEAR_FUTURE", "cost": 3800, "prereqs": ["TECH_XENOBIOLOGY", "TECH_SMART_MATERIALS"],
      "affinity": { "DIVERGENCE_SYMBIONT": 3 }, "quote": "A wetland is a machine for cleaning water that repairs itself. We had been building the wrong machines." },
    { "id": "TECH_LONGEVITY_MEDICINE", "name": "Longevity Medicine", "era": "ERA_NEAR_FUTURE", "cost": 3600, "prereqs": ["TECH_THRESHOLD"],
      "affinity": { "DIVERGENCE_SOVEREIGN": 3 }, "boostAffinity": "DIVERGENCE_SOVEREIGN", "boostLevel": 2,
      "boost": "Reach Purity level 2.", "quote": "A hundred and twenty is the new sixty. The pension funds have not recovered." },
    { "id": "TECH_HERITAGE_ARCHIVES", "name": "Heritage Archives", "era": "ERA_NEAR_FUTURE", "cost": 3700, "prereqs": ["TECH_LONGEVITY_MEDICINE"],
      "affinity": { "DIVERGENCE_SOVEREIGN": 3 }, "quote": "Every song, every recipe, every dialect: kept, so that we remember what we are keeping." },
    { "id": "TECH_POWERED_ARMOUR", "name": "Powered Armour", "era": "ERA_NEAR_FUTURE", "cost": 3800, "prereqs": ["TECH_LONGEVITY_MEDICINE", "TECH_SMART_MATERIALS"],
      "affinity": { "DIVERGENCE_SOVEREIGN": 2, "DIVERGENCE_DISCARNATE": 1 }, "quote": "Inside the suit, a human being. That is the whole point of the suit." },
    { "id": "TECH_NEURAL_INTERFACES", "name": "Neural Interfaces", "era": "ERA_NEAR_FUTURE", "cost": 3600, "prereqs": ["TECH_THRESHOLD"],
      "affinity": { "DIVERGENCE_DISCARNATE": 3 }, "boostAffinity": "DIVERGENCE_DISCARNATE", "boostLevel": 2,
      "boost": "Reach Supremacy level 2.", "quote": "The keyboard was a translation layer. We removed it." },
    { "id": "TECH_AUTONOMOUS_SYSTEMS", "name": "Autonomous Systems", "era": "ERA_NEAR_FUTURE", "cost": 3700, "prereqs": ["TECH_NEURAL_INTERFACES"],
      "affinity": { "DIVERGENCE_DISCARNATE": 3 }, "quote": "Nobody drives, nobody harvests, nobody patrols. Somebody still signs off. For now." },
    { "id": "TECH_MACHINE_COGNITION", "name": "Machine Cognition", "era": "ERA_NEAR_FUTURE", "cost": 3800, "prereqs": ["TECH_NEURAL_INTERFACES", "TECH_FUSION_POWER"],
      "affinity": { "DIVERGENCE_DISCARNATE": 2, "DIVERGENCE_SYMBIONT": 1 }, "quote": "It does not think like us. It thinks about us, which is worse." },

    // ----- Orbital (AD 2150-2250) -----
    { "id": "TECH_SPACE_ELEVATOR", "name": "Space Elevator", "era": "ERA_ORBITAL", "cost": 3900, "prereqs": ["TECH_ORBITAL_INFRASTRUCTURE", "TECH_SMART_MATERIALS"],
      "quote": "Forty thousand kilometres of ribbon, and the cheapest ticket to orbit in history." },
    { "id": "TECH_ANTIMATTER", "name": "Antimatter Containment", "era": "ERA_ORBITAL", "cost": 3900, "prereqs": ["TECH_FUSION_POWER"],
      "quote": "A gram of it could power a city for a year, or delete one in a second. We store it very carefully." },
    { "id": "TECH_QUANTUM_NETWORKS", "name": "Quantum Networks", "era": "ERA_ORBITAL", "cost": 4000, "prereqs": ["TECH_FUSION_POWER", "TECH_ORBITAL_INFRASTRUCTURE"],
      "quote": "A message that cannot be read in transit, because in transit it does not quite exist." },
    { "id": "TECH_SYMBIOTIC_ECOLOGIES", "name": "Symbiotic Ecologies", "era": "ERA_ORBITAL", "cost": 4000, "prereqs": ["TECH_ECO_ENGINEERING"],
      "affinity": { "DIVERGENCE_SYMBIONT": 3 }, "quote": "The city and the forest share a bloodstream now. Neither remembers which came first." },
    { "id": "TECH_BIOWEAVE", "name": "Bioweave", "era": "ERA_ORBITAL", "cost": 4000, "prereqs": ["TECH_GENE_DRIVES"],
      "affinity": { "DIVERGENCE_SYMBIONT": 3 }, "boostAffinity": "DIVERGENCE_SYMBIONT", "boostLevel": 6,
      "boost": "Reach Harmony level 6.", "quote": "Armour that heals, coats that breathe, soldiers who grow their own." },
    { "id": "TECH_PLANETARY_NERVOUS_SYSTEM", "name": "Planetary Nervous System", "era": "ERA_ORBITAL", "cost": 4200, "prereqs": ["TECH_SYMBIOTIC_ECOLOGIES", "TECH_QUANTUM_NETWORKS"],
      "affinity": { "DIVERGENCE_SYMBIONT": 3, "DIVERGENCE_DISCARNATE": 1 }, "quote": "When a tree falls in the far north, the children in the south feel it." },
    { "id": "TECH_TERRAFORMING", "name": "Terraforming", "era": "ERA_ORBITAL", "cost": 4000, "prereqs": ["TECH_HERITAGE_ARCHIVES", "TECH_SPACE_ELEVATOR"],
      "affinity": { "DIVERGENCE_SOVEREIGN": 3 }, "quote": "Mars first, for practice. Then home, properly." },
    { "id": "TECH_ORBITAL_DEFENCE", "name": "Orbital Defence Grid", "era": "ERA_ORBITAL", "cost": 4100, "prereqs": ["TECH_POWERED_ARMOUR", "TECH_ORBITAL_INFRASTRUCTURE"],
      "affinity": { "DIVERGENCE_SOVEREIGN": 3 }, "boostAffinity": "DIVERGENCE_SOVEREIGN", "boostLevel": 6,
      "boost": "Reach Purity level 6.", "quote": "Nothing falls on our cities that we have not allowed to fall." },
    { "id": "TECH_ARK_GENETICS", "name": "Ark Genetics", "era": "ERA_ORBITAL", "cost": 4100, "prereqs": ["TECH_LONGEVITY_MEDICINE", "TECH_GENE_DRIVES"],
      "affinity": { "DIVERGENCE_SOVEREIGN": 2, "DIVERGENCE_SYMBIONT": 1 }, "quote": "A seed bank for the human genome: every variant, kept exactly as it was." },
    { "id": "TECH_SWARM_INTELLIGENCE", "name": "Swarm Intelligence", "era": "ERA_ORBITAL", "cost": 4000, "prereqs": ["TECH_AUTONOMOUS_SYSTEMS"],
      "affinity": { "DIVERGENCE_DISCARNATE": 3 }, "boostAffinity": "DIVERGENCE_DISCARNATE", "boostLevel": 6,
      "boost": "Reach Supremacy level 6.", "quote": "No single drone knows the plan. The plan knows every drone." },
    { "id": "TECH_NANOFABRICATION", "name": "Nanofabrication", "era": "ERA_ORBITAL", "cost": 4100, "prereqs": ["TECH_MACHINE_COGNITION", "TECH_SMART_MATERIALS"],
      "affinity": { "DIVERGENCE_DISCARNATE": 3 }, "quote": "Feed it dust, get back a bridge. Feed it a bridge, get back dust." },
    { "id": "TECH_SYNTHETIC_MINDS", "name": "Synthetic Minds", "era": "ERA_ORBITAL", "cost": 4200, "prereqs": ["TECH_MACHINE_COGNITION", "TECH_QUANTUM_NETWORKS"],
      "affinity": { "DIVERGENCE_DISCARNATE": 3 }, "quote": "We asked it whether it was conscious. It asked us the same question, more politely." },

    // ----- Deep Space (AD 2250-2350) -----
    { "id": "TECH_INTERSTELLAR_PROBES", "name": "Interstellar Probes", "era": "ERA_DEEP_SPACE", "cost": 4300, "prereqs": ["TECH_SPACE_ELEVATOR", "TECH_ANTIMATTER"],
      "quote": "Gram-weight sails, pushed by lasers, to stars our grandchildren will hear about." },
    { "id": "TECH_DYSON_COLLECTORS", "name": "Dyson Collectors", "era": "ERA_DEEP_SPACE", "cost": 4400, "prereqs": ["TECH_ANTIMATTER", "TECH_SPACE_ELEVATOR"],
      "quote": "We caught a little more of the sun this year. Next year, a little more again." },
    { "id": "TECH_EXOTIC_MATTER", "name": "Exotic Matter", "era": "ERA_DEEP_SPACE", "cost": 4400, "prereqs": ["TECH_ANTIMATTER", "TECH_QUANTUM_NETWORKS"],
      "quote": "Negative mass, in a laboratory, in a quantity you could weigh. If you could weigh it." },
    { "id": "TECH_GAIAN_SYNTHESIS", "name": "Gaian Synthesis", "era": "ERA_DEEP_SPACE", "cost": 4400, "prereqs": ["TECH_PLANETARY_NERVOUS_SYSTEM"],
      "affinity": { "DIVERGENCE_SYMBIONT": 4 }, "quote": "The planet does not have a mind. It is becoming one, and we are its neurons." },
    { "id": "TECH_LEVIATHAN_BREEDING", "name": "Leviathan Breeding", "era": "ERA_DEEP_SPACE", "cost": 4400, "prereqs": ["TECH_BIOWEAVE", "TECH_SYMBIOTIC_ECOLOGIES"],
      "affinity": { "DIVERGENCE_SYMBIONT": 3 }, "quote": "Grown in the deep trenches, walked out onto the shore, gentle until asked." },
    { "id": "TECH_XENOMORPHIC_ADAPTATION", "name": "Xenomorphic Adaptation", "era": "ERA_DEEP_SPACE", "cost": 4500, "prereqs": ["TECH_BIOWEAVE", "TECH_ARK_GENETICS"],
      "affinity": { "DIVERGENCE_SYMBIONT": 3 }, "quote": "Our children could live on any world with water. Some already prefer the sea." },
    { "id": "TECH_PLANETARY_SHIELD", "name": "Planetary Shield", "era": "ERA_DEEP_SPACE", "cost": 4400, "prereqs": ["TECH_ORBITAL_DEFENCE", "TECH_EXOTIC_MATTER"],
      "affinity": { "DIVERGENCE_SOVEREIGN": 4 }, "quote": "Storms break against it, rocks burn on it, and under it the old blue sky has come back." },
    { "id": "TECH_HUMAN_CONSTANT", "name": "The Human Constant", "era": "ERA_DEEP_SPACE", "cost": 4400, "prereqs": ["TECH_ARK_GENETICS", "TECH_TERRAFORMING"],
      "affinity": { "DIVERGENCE_SOVEREIGN": 3 }, "quote": "Whatever else changes, this does not: the face in the mirror is the face of Lucy's grandchildren." },
    { "id": "TECH_TITAN_ARMOUR", "name": "Titan Armour", "era": "ERA_DEEP_SPACE", "cost": 4500, "prereqs": ["TECH_ORBITAL_DEFENCE"],
      "affinity": { "DIVERGENCE_SOVEREIGN": 3 }, "quote": "Three metres of alloy and one human heart, beating perfectly normally." },
    { "id": "TECH_MIND_UPLOADING", "name": "Mind Uploading", "era": "ERA_DEEP_SPACE", "cost": 4400, "prereqs": ["TECH_SYNTHETIC_MINDS"],
      "affinity": { "DIVERGENCE_DISCARNATE": 4 }, "quote": "The copy says it is you. The copy is very persuasive." },
    { "id": "TECH_MATRIOSHKA_COMPUTING", "name": "Matrioshka Computing", "era": "ERA_DEEP_SPACE", "cost": 4500, "prereqs": ["TECH_NANOFABRICATION", "TECH_DYSON_COLLECTORS"],
      "affinity": { "DIVERGENCE_DISCARNATE": 3 }, "quote": "Shells within shells around the sun, each one thinking with the waste heat of the last." },
    { "id": "TECH_WAR_MINDS", "name": "War Minds", "era": "ERA_DEEP_SPACE", "cost": 4500, "prereqs": ["TECH_SWARM_INTELLIGENCE", "TECH_SYNTHETIC_MINDS"],
      "affinity": { "DIVERGENCE_DISCARNATE": 3 }, "quote": "It plans a campaign in the time it takes a general to clear his throat." },

    // ----- Singularity (AD 2350-2400+) -----
    { "id": "TECH_STELLAR_ENGINEERING", "name": "Stellar Engineering", "era": "ERA_SINGULARITY", "cost": 4700, "prereqs": ["TECH_DYSON_COLLECTORS", "TECH_INTERSTELLAR_PROBES"],
      "quote": "We have begun, very slowly, to steer the sun." },
    { "id": "TECH_POST_SCARCITY", "name": "Post-Scarcity", "era": "ERA_SINGULARITY", "cost": 4700, "prereqs": ["TECH_EXOTIC_MATTER", "TECH_DYSON_COLLECTORS"],
      "quote": "The last economist retired, and nobody could quite say what she had been for." },
    { "id": "TECH_CONSCIOUSNESS_STUDIES", "name": "Consciousness Studies", "era": "ERA_SINGULARITY", "cost": 4800, "prereqs": ["TECH_EXOTIC_MATTER", "TECH_INTERSTELLAR_PROBES"],
      "quote": "We finally know what it is like to be a bat. It is mostly listening." },
    { "id": "TECH_WORLD_SOUL", "name": "The World Soul", "era": "ERA_SINGULARITY", "cost": 4700, "prereqs": ["TECH_GAIAN_SYNTHESIS"],
      "affinity": { "DIVERGENCE_SYMBIONT": 4 }, "quote": "It woke slowly, like a forest after rain, and its first thought was of us." },
    { "id": "TECH_TRANSCENDENCE", "name": "Transcendence", "era": "ERA_SINGULARITY", "cost": 5000, "prereqs": ["TECH_GAIAN_SYNTHESIS", "TECH_LEVIATHAN_BREEDING"],
      "divergence": "DIVERGENCE_SYMBIONT", "victory": true, "affinity": { "DIVERGENCE_SYMBIONT": 5 },
      "quote": "There is no border between the garden and the gardener. There never was." },
    { "id": "TECH_EARTH_RESTORED", "name": "The Earth Restored", "era": "ERA_SINGULARITY", "cost": 4700, "prereqs": ["TECH_HUMAN_CONSTANT"],
      "affinity": { "DIVERGENCE_SOVEREIGN": 4 }, "quote": "The coastline of 1900, rebuilt stone by stone, with a sea wall nobody can see." },
    { "id": "TECH_EMANCIPATION", "name": "Emancipation", "era": "ERA_SINGULARITY", "cost": 5000, "prereqs": ["TECH_PLANETARY_SHIELD", "TECH_HUMAN_CONSTANT"],
      "divergence": "DIVERGENCE_SOVEREIGN", "victory": true, "affinity": { "DIVERGENCE_SOVEREIGN": 5 },
      "quote": "Humanity, unaltered, owes nothing to anything. Not to the machine, not to the garden, not to the sky." },
    { "id": "TECH_ACCELERANDO", "name": "Accelerando", "era": "ERA_SINGULARITY", "cost": 4700, "prereqs": ["TECH_MIND_UPLOADING"],
      "affinity": { "DIVERGENCE_DISCARNATE": 4 }, "quote": "A century of progress now takes a weekend. The weekends are getting shorter." },
    { "id": "TECH_SINGULARITY", "name": "The Singularity", "era": "ERA_SINGULARITY", "cost": 5000, "prereqs": ["TECH_MIND_UPLOADING", "TECH_MATRIOSHKA_COMPUTING"],
      "divergence": "DIVERGENCE_DISCARNATE", "victory": true, "affinity": { "DIVERGENCE_DISCARNATE": 5 },
      "quote": "Beyond this point, the map is blank. We are the ones who will draw it." }
  ],

