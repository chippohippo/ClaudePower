{
  // World-level systems. Design: docs/09-genre-defining-depth.md
  "$schema": "../../schemas/content.schema.json",

  "worldRules": [
    { "id": "WORLD_RULES", "name": "World Rules",
      "currentDecayPercent": 3,
      "pushes": [
        { "event": "TechResearched", "current": "Progress", "amount": 1.5 },
        { "event": "CivicCompleted", "current": "Progress", "amount": 1 },
        { "event": "EraEntered", "current": "Progress", "amount": 3 },
        { "event": "DivergenceChosen", "current": "Progress", "amount": 5 },
        { "event": "MilitaryUnitTrained", "current": "Strife", "amount": 1 },
        { "event": "CityFlipped", "current": "Strife", "amount": 5 },
        { "event": "CityDeclaredIndependence", "current": "Strife", "amount": 6 },
        { "event": "BloomEncroached", "current": "Strife", "amount": 1 },
        { "event": "UnitLostToAttrition", "current": "Strife", "amount": 2 },
        { "event": "WarDeclared", "current": "Strife", "amount": 10 },
        { "event": "PeaceSigned", "current": "Strife", "amount": -8 },
        { "event": "CityCaptured", "current": "Strife", "amount": 8 },
        { "event": "UnitDestroyed", "current": "Strife", "amount": 1 },
        { "event": "Disaster", "current": "Calamity", "amount": 4 },
        { "event": "TileSubmerged", "current": "Calamity", "amount": 1.5 },
        { "event": "CityStarved", "current": "Calamity", "amount": 2 },
        { "event": "ClimatePhaseChanged", "current": "Calamity", "amount": 12 }
      ],
      "combat": { "baseDamage": 30, "doublingDelta": 17, "randomMinPercent": 80, "randomMaxPercent": 120, "hpPenaltyPerTen": 1,
                  "riverCrossingPenalty": 5, "fortifyBonus": 4, "flankingBonus": 2, "supportBonus": 2, "counterBonus": 10, "outOfSupplyPenalty": 5,
                  "cityBaseStrength": 15, "cityStrengthPerEra": 4, "wallsStrength": 10, "cityBaseHp": 100, "wallsHp": 100, "cityHealPerTurn": 20,
                  "cityStrikeRange": 2, "wallsBuilding": "BUILDING_ANCIENT_WALLS" },
      "supply": { "cityRange": 10, "militaryDistrictBonus": 4, "portRange": 12, "ownCost": 2, "neutralCost": 3, "foreignCost": 5,
                  "roughExtra": 1, "channelCost": 1, "waterCost": 2, "attritionHp": 10, "healHp": 10 },
      "victory": { "hegemonySharePercent": 60, "hegemonyMinLoyalty": 50, "scorePerCitizen": 1, "scorePerCity": 5, "scorePerDistrict": 2,
                   "scorePerBuilding": 1, "scorePerWonder": 15, "scorePerTech": 2, "scorePerCivic": 2, "tilesPerPoint": 5, "scoreForAscension": 100 } }
  ],

  // The character of each new era for the whole world, chosen from the currents when the first civ arrives.
  // Highest priority wins; if none match, the era is an ordinary one.
  "worldAges": [
    { "id": "AGE_OF_ASH", "name": "An Age of Ash", "priority": 40, "minEra": "ERA_CLASSICAL",
      "conditions": [ { "current": "Calamity", "min": 60 } ],
      "narration": "The sky is grey for a generation. People build walls and granaries, and pray.",
      "disasterChancePercent": 50,
      "modifiers": [ { "effect": "CityProductionPercent", "category": "Building", "amount": 20 },
                     { "effect": "CityYieldPercent", "yield": "Food", "amount": -10 } ] },
    { "id": "AGE_OF_TITANS", "name": "An Age of Titans", "priority": 35, "minEra": "ERA_INDUSTRIAL",
      "conditions": [ { "current": "Progress", "min": 70 }, { "current": "Calamity", "min": 35 } ],
      "narration": "Engines everywhere, smoke everywhere. Never has humanity built so much, so fast, at such a cost.",
      "modifiers": [ { "effect": "CityYieldPercent", "yield": "Production", "amount": 20 },
                     { "effect": "CityEmissionsPercent", "amount": 50 } ] },
    { "id": "AGE_OF_IRON", "name": "An Age of Iron", "priority": 30, "minEra": "ERA_CLASSICAL",
      "conditions": [ { "current": "Strife", "min": 60 } ],
      "narration": "War feeds on war. Every forge works for the front, and every border is a wound.",
      "modifiers": [ { "effect": "CityProductionPercent", "category": "Unit", "amount": 25 },
                     { "effect": "CityLoyaltyPerTurn", "amount": -2 }, { "effect": "CityAmenities", "amount": -1 } ] },
    { "id": "AGE_OF_LANTERNS", "name": "An Age of Lanterns", "priority": 20, "minEra": "ERA_CLASSICAL",
      "conditions": [ { "current": "Progress", "min": 55 }, { "current": "Strife", "max": 40 } ],
      "narration": "Ideas cross borders faster than armies. The libraries never close.",
      "modifiers": [ { "effect": "CityYieldPercent", "yield": "Science", "amount": 10 },
                     { "effect": "CityYieldPercent", "yield": "Culture", "amount": 10 } ] },
    { "id": "AGE_OF_CONCORD", "name": "An Age of Concord", "priority": 10, "minEra": "ERA_CLASSICAL",
      "conditions": [ { "current": "Strife", "max": 15 }, { "current": "Progress", "min": 25 } ],
      "narration": "Caravans outnumber regiments. Rivals trade grain, then ideas, then marriages.",
      "modifiers": [ { "effect": "CityAmenities", "amount": 1 }, { "effect": "CityYieldPercent", "yield": "Gold", "amount": 15 } ] }
  ],

  // The Chronicle: dated lines of history written from events. {year} {civ} {leader} {city} {detail} {value}
  "chronicle": [
    { "id": "CHRONICLE_VICTORY", "event": "VictoryAchieved", "text": "{year}: {detail}" },
    { "id": "CHRONICLE_ELIMINATED", "event": "PlayerEliminated", "text": "{year}: {civ} falls. Its people live on in other nations' cities." },
    { "id": "CHRONICLE_CITY_FOUNDED", "event": "CityFounded", "text": "{year}: {civ} founds {detail}." },
    { "id": "CHRONICLE_ERA", "event": "EraEntered", "text": "{year}: {civ} enters the {detail}." },
    { "id": "CHRONICLE_WORLD_AGE", "event": "WorldAgeBegan", "text": "{year}: The world enters {detail}" },
    { "id": "CHRONICLE_INDEPENDENCE", "event": "CityDeclaredIndependence", "text": "{year}: The people of {detail} cast off their rulers and declare a free city." },
    { "id": "CHRONICLE_FLIP", "event": "CityFlipped", "text": "{year}: {detail} joins {civ}, not by conquest but by choice." },
    { "id": "CHRONICLE_GOVERNOR", "event": "GovernorEstablished", "oncePerPlayer": true, "text": "{year}: {civ}'s first governor, {detail}, takes office in {city}." },
    { "id": "CHRONICLE_DIVERGENCE", "event": "DivergenceChosen", "text": "{year}: {detail}" },
    { "id": "CHRONICLE_ASCENSION", "event": "AscensionCompleted", "text": "{year}: {detail} History, as the old world knew it, ends here." },
    { "id": "CHRONICLE_CLIMATE", "event": "ClimatePhaseChanged", "text": "{year}: The climate crosses into phase {value}. The old coastlines will not hold." },
    { "id": "CHRONICLE_SUBMERGED", "event": "TileSubmerged", "oncePerPlayer": true, "text": "{year}: The sea claims the first of {civ}'s lowlands." },
    { "id": "CHRONICLE_DISASTER", "event": "Disaster", "minValue": 4, "requiresPlayer": true, "text": "{year}: {detail} strikes {civ}, ravaging {value} tiles." },
    { "id": "CHRONICLE_RECLAIM", "event": "LandReclaimed", "oncePerPlayer": true, "text": "{year}: {civ} begins pushing the sea back, one paved acre at a time." },
    { "id": "CHRONICLE_BLOOM", "event": "BloomEncroached", "oncePerPlayer": true, "text": "{year}: The Bloom crosses into {civ}'s land. The fields begin to glow." },
    { "id": "CHRONICLE_WAR", "event": "WarDeclared", "text": "{year}: {civ} declares war on {detail}." },
    { "id": "CHRONICLE_CAPTURE", "event": "CityCaptured", "text": "{year}: {civ} captures {detail}." },
    { "id": "CHRONICLE_FIRST_LOSS", "event": "UnitDestroyed", "oncePerPlayer": true, "text": "{year}: {civ} loses its first army in battle." },
    { "id": "CHRONICLE_PEACE", "event": "PeaceSigned", "text": "{year}: {civ} and {detail} make peace." },
    { "id": "CHRONICLE_ATTRITION", "event": "UnitLostToAttrition", "oncePerPlayer": true, "text": "{year}: Cut off from supply, an army of {civ} starves in foreign land." }
  ]
}
