{
  // Terrain = base biome; Relief = flat/hills/mountain layered on top; Features sit on either.
  "$schema": "../../schemas/content.schema.json",
  "terrains": [
    { "id": "TERRAIN_GRASSLAND", "name": "Grassland", "class": "Land", "yields": { "food": 2 } },
    { "id": "TERRAIN_PLAINS",    "name": "Plains",    "class": "Land", "yields": { "food": 1, "production": 1 } },
    { "id": "TERRAIN_DESERT",    "name": "Desert",    "class": "Land", "yields": {}, "appeal": -1 },
    { "id": "TERRAIN_TUNDRA",    "name": "Tundra",    "class": "Land", "yields": { "food": 1 } },
    { "id": "TERRAIN_SNOW",      "name": "Snow",      "class": "Land", "yields": {}, "appeal": -1 },
    { "id": "TERRAIN_COAST",     "name": "Coast",     "class": "Coast", "yields": { "food": 1, "gold": 1 } },
    { "id": "TERRAIN_OCEAN",     "name": "Ocean",     "class": "Ocean", "yields": { "food": 1 } },
    { "id": "TERRAIN_LAKE",      "name": "Lake",      "class": "Lake",  "yields": { "food": 1, "gold": 1 }, "freshWater": true, "appeal": 1 },
    {
      "id": "TERRAIN_CHANNEL", "name": "Great River", "class": "Channel",
      "description": "Navigable fresh water. Boats sail it from the Ancient Era; land units ford it at heavy cost or cross on bridges.",
      "yields": { "food": 1, "gold": 1 }, "freshWater": true, "appeal": 1, "fordCost": 3
    }
  ],
  "reliefs": [
    { "id": "RELIEF_FLAT",     "name": "Flat",     "yields": {}, "moveCost": 1 },
    { "id": "RELIEF_HILLS",    "name": "Hills",    "yields": { "production": 1 }, "moveCost": 2, "defense": 3 },
    { "id": "RELIEF_MOUNTAIN", "name": "Mountain", "yields": {}, "moveCost": 3, "impassable": true, "appeal": 1 }
  ],
  "features": [
    { "id": "FEATURE_FOREST", "name": "Woods", "yields": { "production": 1 }, "moveCost": 2, "defense": 3, "appeal": 1,
      "co2Absorption": 0.0004, "co2OnRemoval": 2, "validTerrains": ["TERRAIN_GRASSLAND", "TERRAIN_PLAINS", "TERRAIN_TUNDRA"], "tags": ["Woods"] },
    { "id": "FEATURE_RAINFOREST", "name": "Rainforest", "yields": { "food": 1 }, "moveCost": 2, "defense": 3,
      "co2Absorption": 0.0006, "co2OnRemoval": 3, "validTerrains": ["TERRAIN_GRASSLAND", "TERRAIN_PLAINS"], "tags": ["Woods"] },
    { "id": "FEATURE_MARSH", "name": "Marsh", "yields": { "food": 1 }, "moveCost": 2, "appeal": -1,
      "co2Absorption": 0.0002, "co2OnRemoval": 1, "validTerrains": ["TERRAIN_GRASSLAND"] },
    { "id": "FEATURE_FLOODPLAINS", "name": "Floodplains", "yields": { "food": 1 },
      "description": "Fertile but flood-prone. Floods add permanent fertility; Dams prevent the damage.",
      "validTerrains": ["TERRAIN_DESERT", "TERRAIN_PLAINS", "TERRAIN_GRASSLAND"], "tags": ["FloodProne"] },
    { "id": "FEATURE_OASIS", "name": "Oasis", "yields": { "food": 3, "gold": 1 }, "freshWater": true, "removable": false, "appeal": 1,
      "validTerrains": ["TERRAIN_DESERT"] },
    { "id": "FEATURE_ICE", "name": "Ice", "yields": {}, "impassable": true, "removable": false,
      "validTerrains": ["TERRAIN_COAST", "TERRAIN_OCEAN"] },
    { "id": "FEATURE_VOLCANO", "name": "Volcano", "yields": {}, "removable": false, "tags": ["Volcanic"] },
    { "id": "FEATURE_GEOTHERMAL", "name": "Geothermal Fissure", "yields": { "science": 1 }, "removable": false, "appeal": 1,
      "validTerrains": ["TERRAIN_PLAINS", "TERRAIN_TUNDRA", "TERRAIN_GRASSLAND", "TERRAIN_DESERT"] },
    { "id": "FEATURE_REEF", "name": "Reef", "yields": { "food": 1, "production": 1 }, "removable": false, "appeal": 2,
      "validTerrains": ["TERRAIN_COAST"] }
  ]
}
