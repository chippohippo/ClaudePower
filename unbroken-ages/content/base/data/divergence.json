      "onComplete": [ { "effect": "CompleteAscension", "amount": 1 } ] },
    { "id": "PROJECT_LAST_UPLOAD", "name": "The Last Upload", "district": "DISTRICT_CITY_CENTER", "cost": 3000,
      "prereqTech": "TECH_LAST_UPLOAD", "divergence": "DIVERGENCE_DISCARNATE", "requiresWorldTransformedPercent": 10,
      "description": "Archive the final biological citizens and run civilization entirely on Substrate. Ascension victory.",
      "onComplete": [ { "effect": "CompleteAscension", "amount": 1 } ] }
  ],

  "units": [
    { "id": "UNIT_WARDEN_LEGION", "name": "Warden Legion", "domain": "Land", "unitClass": "Melee", "era": "ERA_FUTURE", "cost": 1125, "maintenance": 8,
      "strength": 105, "moves": 2, "prereqTech": "TECH_GENOME_REGISTRY", "resourceCost": { "resource": "RESOURCE_STEEL", "amount": 5 }, "tags": ["Augmented"], "strongAgainst": ["Machine"], "weakAgainst": ["Living"],
      "description": "Unmodified humans in sealed armour. The Registry guarantees every one of them is exactly human." },
    { "id": "UNIT_MIRROR_LANCER", "name": "Mirror Lancer", "domain": "Air", "unitClass": "Bomber", "era": "ERA_FUTURE", "cost": 1250, "maintenance": 8,
      "strength": 80, "rangedStrength": 120, "range": 4, "moves": 6, "prereqTech": "TECH_STRATOSPHERIC_VEIL", "resourceCost": { "resource": "RESOURCE_ELECTRONICS", "amount": 5 }, "tags": ["Augmented"], "strongAgainst": ["Machine"],
      "description": "Strike craft riding the Veil's mirror arrays, focusing sunlight the sky no longer receives." },
    { "id": "UNIT_BASTION_STRIDER", "name": "Bastion Strider", "domain": "Land", "unitClass": "HeavyCavalry", "era": "ERA_FUTURE", "cost": 1750, "maintenance": 10,
      "strength": 135, "moves": 3, "prereqTech": "TECH_ARCOLOGY_DOCTRINE", "resourceCost": { "resource": "RESOURCE_STEEL", "amount": 10 }, "tags": ["Augmented", "Armor"], "strongAgainst": ["Machine"], "weakAgainst": ["Living"],
      "description": "A walking fortress with a human crew of twelve, all registered." },

    { "id": "UNIT_GRAFTED_BEHEMOTH", "name": "Grafted Behemoth", "domain": "Land", "unitClass": "HeavyCavalry", "era": "ERA_FUTURE", "cost": 1750, "maintenance": 10,
      "strength": 135, "moves": 3, "prereqTech": "TECH_BEAST_SHAPING", "tags": ["Living"], "strongAgainst": ["Augmented"], "weakAgainst": ["Machine"],
      "description": "Grown, not built. It heals in the Bloom and does not understand retreat." },
    { "id": "UNIT_SPORE_DRIFTER", "name": "Spore Drifter", "domain": "Air", "unitClass": "Bomber", "era": "ERA_FUTURE", "cost": 1250, "maintenance": 8,
      "strength": 70, "rangedStrength": 115, "range": 4, "moves": 5, "prereqTech": "TECH_BEAST_SHAPING", "tags": ["Living"], "strongAgainst": ["Augmented"],
      "description": "A gas-bladder organism that seeds the Bloom wherever its spores land." },
    { "id": "UNIT_TIDAL_LEVIATHAN", "name": "Tidal Leviathan", "domain": "Naval", "unitClass": "NavalMelee", "era": "ERA_FUTURE", "cost": 1625, "maintenance": 9,
      "strength": 130, "moves": 5, "oceanGoing": true, "riverCapable": true, "prereqTech": "TECH_TIDAL_GRAFTING", "tags": ["Living"], "strongAgainst": ["Augmented"],
      "description": "Swims up Great Rivers as easily as oceans. Its handlers swim with it." },

