      "description": "Seal humanity, unchanged, inside a planet built to keep it. Ascension victory.",
      "onComplete": [ { "effect": "CompleteAscension", "amount": 1 } ] },
    { "id": "PROJECT_THE_CHORUS", "name": "The Chorus Wakes", "district": "DISTRICT_CITY_CENTER", "cost": 3000,
      "prereqTech": "TECH_THE_CHORUS", "divergence": "DIVERGENCE_SYMBIONT", "requiresWorldTransformedPercent": 10,
