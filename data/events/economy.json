[
 {
  "id": "stock_crash",
  "title": "Panic on the Exchange",
  "description": "Share prices in {country} collapse as investors flee. Banks call in loans.",
  "scope": "country",
  "trigger": {
   "all": [
    {
     "stat": {
      "key": "debtRatio",
      "op": ">",
      "value": 0.5
