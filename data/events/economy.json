  "mtth": 60,
  "once": false,
  "cooldown": 60,
  "reactsTo": [],
  "triggeredOnly": false,
  "choices": [
   {
    "name": "Rescue the banks",
    "effects": [
     {
      "treasuryMonths": -2
     },
     {
      "igFavour": {
       "id": "industrialists",
       "value": 20
      }
     },
     {
      "igFavour": {
       "id": "trade_unions",
       "value": -10
      }
     }
    ],
    "ai": 2
   },
   {
    "name": "Let them fail",
    "effects": [
     {
      "modifier": {
       "name": "Credit crunch",
       "target": "investment_rate",
       "mult": -0.3,
       "months": 24
      }
     },
     {
      "igFavour": {
       "id": "petite_bourgeoisie",
       "value": -15
      }
     }
    ],
    "ai": 1
   }
  ]
 },
